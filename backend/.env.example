# ---- 设备层 ----
# mock   = 模拟设备，不需要硬件，用于开发与断网演示
# serial = 真实串口，连 NodeA 的 USB(CH340)
DEVICE_MODE=mock

# NodeA 的串口号。Windows 上形如 COM3，在设备管理器里看 CH340 对应哪个口
SERIAL_PORT=COM3
SERIAL_BAUD=9600

# ---- 存储 ----
# 留空则用 backend/data/dorm.db
# DB_URL=sqlite:///C:/path/to/dorm.db
TELEMETRY_PERIOD_S=1.0
TELEMETRY_KEEP_DAYS=14

# ---- 服务 ----
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# ---- LLM（留空则 AI 助手不可用，其余功能正常）----
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=30
# false=忽略系统代理并直连；只有确实依赖 HTTP(S)_PROXY 时才改为 true
LLM_TRUST_ENV=false
